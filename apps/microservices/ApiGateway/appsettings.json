{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-home",
        "Match": { "Path": "/api/auth/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "homes-route": {
        "ClusterId": "user-home",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/homes/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "devices-route": {
        "ClusterId": "device-management",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/devices/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "temperature-route": {
        "ClusterId": "temperature-monitoring",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/houses/{houseId}/temperature/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "heating-route": {
        "ClusterId": "heating-control",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/houses/{houseId}/heating/{**remainder}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "notifications-route": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/users/{userId}/notifications" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "user-home": {
        "Destinations": { "d1": { "Address": "http://user-home-service:8080" } }
      },
      "device-management": {
        "Destinations": { "d1": { "Address": "http://device-management-service:8080" } }
      },
      "temperature-monitoring": {
        "Destinations": { "d1": { "Address": "http://temperature-monitoring-service:8080" } }
      },
      "heating-control": {
        "Destinations": { "d1": { "Address": "http://heating-control-service:8080" } }
      },
      "notification": {
        "Destinations": { "d1": { "Address": "http://notification-service:8080" } }
      }
    }
  }
}
